{
  "name": "miliastra-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project-scoped Miliastra skills, MCP tools, modular Lua build and deployment",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "setup": "node tools/setup-project.mjs",
    "check": "node scripts/check-integrations.mjs",
    "build": "node scripts/generate-pixel-glyphs.mjs && node tools/lua-project.mjs build",
    "build:lua": "node scripts/generate-pixel-glyphs.mjs && node tools/lua-project.mjs build",
    "build:book": "node scripts/build-opening-book.mjs",
    "check:book": "node scripts/build-opening-book.mjs --check",
    "test:book": "node --test scripts/test-opening-book.mjs && node scripts/run-lua-check.mjs tests/lua-book-data.lua && node scripts/run-lua-check.mjs tests/lua-opening-book.lua",
    "deploy:lua": "node scripts/generate-pixel-glyphs.mjs && node tools/lua-project.mjs deploy",
    "test": "node --test scripts/test-game-save.mjs scripts/test-lua-bundle.mjs scripts/test-lua-project.mjs scripts/test-setup.mjs scripts/test-ai-test-runtime.mjs",
    "patch:simulator": "node scripts/patch-simulator-renderer.mjs",
    "test:simulator-renderer": "node --test scripts/test-simulator-text-resolution.mjs scripts/test-simulator-input.mjs",
    "test:simulator-input": "node --test scripts/test-simulator-input.mjs && node scripts/test-simulator-input-native.mjs",
    "preview": "npm run build:game && node scripts/patch-simulator-renderer.mjs && beyond-simulator-web --workspace . --open",
    "preview:html": "node scripts/serve-prototype.mjs",
    "check:game-cases": "node scripts/check-game-cases.mjs",
    "test:prototype": "node --test scripts/test-prototype.mjs",
    "test:lua": "node scripts/run-lua-check.mjs tests/lua-regression.lua",
    "test:lua:undo": "node scripts/run-lua-check.mjs tests/lua-undo-confirm.lua",
    "test:lua:result-review": "node scripts/run-lua-check.mjs tests/lua-result-review.lua",
    "test:lua:native-text": "node scripts/run-lua-check.mjs tests/lua-native-text.lua",
    "test:pixel:simulator": "node scripts/test-pixel-glyphs.mjs",
    "test:lua:screen": "node scripts/run-lua-check.mjs tests/lua-screen-shell.lua",
    "test:screen:simulator": "node scripts/test-screen-shell.mjs",
    "test:native-text:layouts": "node scripts/test-native-text-layouts.mjs",
    "test:result-review:simulator": "node scripts/test-result-review-layouts.mjs",
    "test:lua:audio": "node scripts/run-lua-check.mjs tests/lua-audio-settings.lua && node scripts/run-lua-check.mjs tests/lua-audio-controller.lua",
    "test:lua:44": "node scripts/run-lua-check.mjs tests/lua-44-rooks.lua",
    "test:lua:completion": "node scripts/run-lua-check.mjs tests/lua-completion.lua",
    "test:completion:simulator": "node scripts/test-completion-simulator.mjs",
    "test:audio:simulator": "node scripts/test-audio-layouts.mjs",
    "test:lua:check-audio": "node scripts/run-lua-check.mjs tests/lua-check-audio.lua",
    "test:lua:result-audio": "node scripts/run-lua-check.mjs tests/lua-result-audio.lua",
    "test:result-audio:simulator": "node scripts/test-result-audio-simulator.mjs",
    "test:check-audio:simulator": "node scripts/test-check-audio-simulator.mjs",
    "test:lua:exchange": "node scripts/run-lua-check.mjs tests/lua-ai-exchange.lua && node scripts/run-lua-check.mjs tests/lua-ai-user-cannon.lua",
    "test:lua:pvs": "node scripts/run-lua-check.mjs tests/lua-ai-pvs.lua && node scripts/run-lua-check.mjs tests/lua-ai-threats.lua",
    "test:lua:tactics": "node scripts/run-lua-check.mjs tests/lua-ai-tactics.lua",
    "test:ai:rules": "node scripts/run-lua-check.mjs tests/lua-ai-rules.lua",
    "test:ai:custom": "node scripts/run-lua-check.mjs tests/lua-ai-custom-light.lua",
    "test:ai:custom:profile": "node scripts/test-ai-custom-light.mjs",
    "test:ai:throughput": "node scripts/test-ai-throughput.mjs",
    "test:ai:core": "node scripts/verify-ai-core.mjs",
    "test:ai:regression": "node scripts/run-ai-rule-regressions.mjs",
    "test:ai:runtime": "node --test scripts/test-ai-test-runtime.mjs",
    "test:ai:readiness": "node scripts/test-ai-readiness.mjs",
    "test:ai:smoke": "node scripts/test-ai-strength-smoke.mjs",
    "test:lua:wait": "node scripts/run-lua-check.mjs tests/lua-wait-extension.lua",
    "test:lua:fc-wait": "node scripts/run-lua-check.mjs tests/lua-fc-wait.lua",
    "test:lua:feedback": "node scripts/run-lua-check.mjs tests/lua-feedback.lua",
    "test:lua:animation": "node scripts/run-lua-check.mjs tests/lua-move-animation.lua",
    "test:lua:audio-animation": "node scripts/run-lua-check.mjs tests/lua-audio-animation.lua",
    "test:audio-animation:simulator": "node scripts/test-audio-animation.mjs",
    "test:animation:simulator": "node scripts/test-move-animation.mjs",
    "test:lua:soak": "node scripts/run-lua-check.mjs tests/lua-soak.lua",
    "test:lua:performance": "node scripts/profile-lua.mjs",
    "test:simulator": "node scripts/run-simulator-cases.mjs",
    "build:game": "node scripts/generate-audio-catalog.mjs && node scripts/generate-fixtures.mjs && npm run build:lua && node scripts/sync-game-save.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "beyond-simulator-mcp": "0.4.1",
    "beyond-simulator-web": "0.4.1",
    "fengari": "0.1.5",
    "undici": "8.11.2",
    "zod": "4.6.6"
  }
}
