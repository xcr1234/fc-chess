{
  "name": "miliastra-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project-scoped Miliastra skills, MCP tools, modular Lua build and deployment",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "setup": "node tools/setup-project.mjs",
    "check": "node scripts/check-integrations.mjs",
    "build": "node tools/lua-project.mjs build",
    "build:lua": "node tools/lua-project.mjs build",
    "build:book": "node scripts/build-opening-book.mjs",
    "check:book": "node scripts/build-opening-book.mjs --check",
    "test:book": "node --test scripts/test-opening-book.mjs && node scripts/run-lua-check.mjs tests/lua-book-data.lua && node scripts/run-lua-check.mjs tests/lua-opening-book.lua",
    "deploy:lua": "node tools/lua-project.mjs deploy",
    "test": "node --test scripts/test-lua-bundle.mjs scripts/test-lua-project.mjs scripts/test-setup.mjs",
    "patch:simulator": "node scripts/patch-simulator-renderer.mjs",
    "test:simulator-renderer": "node --test scripts/test-simulator-text-resolution.mjs",
    "preview": "node scripts/patch-simulator-renderer.mjs && beyond-simulator-web --workspace . --open",
    "preview:html": "node scripts/serve-prototype.mjs",
    "check:game-cases": "node scripts/check-game-cases.mjs",
    "test:prototype": "node --test scripts/test-prototype.mjs",
    "test:lua": "node scripts/run-lua-check.mjs tests/lua-regression.lua",
    "test:lua:exchange": "node scripts/run-lua-check.mjs tests/lua-ai-exchange.lua && node scripts/run-lua-check.mjs tests/lua-ai-user-cannon.lua",
    "test:lua:pvs": "node scripts/run-lua-check.mjs tests/lua-ai-pvs.lua && node scripts/run-lua-check.mjs tests/lua-ai-threats.lua",
    "test:lua:tactics": "node scripts/run-lua-check.mjs tests/lua-ai-tactics.lua",
    "test:lua:wait": "node scripts/run-lua-check.mjs tests/lua-wait-extension.lua",
    "test:lua:feedback": "node scripts/run-lua-check.mjs tests/lua-feedback.lua",
    "test:lua:soak": "node scripts/run-lua-check.mjs tests/lua-soak.lua",
    "test:lua:performance": "node scripts/profile-lua.mjs",
    "test:simulator": "node scripts/run-simulator-cases.mjs",
    "build:game": "node scripts/generate-fixtures.mjs && npm run build:lua && node scripts/sync-game-save.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "beyond-simulator-mcp": "0.4.1",
    "beyond-simulator-web": "0.4.1",
    "fengari": "0.1.5",
    "undici": "8.11.2",
    "zod": "4.6.6"
  }
}
